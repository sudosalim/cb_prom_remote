# Example environment variables for Couchbase remote write service
# Copy this file to .env and update with your actual values

# =============================================================================
# COUCHBASE CONNECTION SETTINGS
# =============================================================================

COUCHBASE_CONNECTION_STRING=couchbase://localhost
COUCHBASE_USERNAME=your-username
COUCHBASE_PASSWORD=your-password

# Database Configuration
COUCHBASE_BUCKET=cbmonitor
COUCHBASE_SCOPE=_default
COUCHBASE_COLLECTION=_default

# Connection Timeouts
COUCHBASE_CONNECT_TIMEOUT=30s
COUCHBASE_KV_TIMEOUT=10s

# =============================================================================
# HTTP SERVER SETTINGS
# =============================================================================

SERVER_LISTEN_ADDRESS=:8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_MAX_REQUEST_SIZE=33554432  # 32MB

# TLS Configuration (if enabled)
SERVER_TLS_ENABLED=false
SERVER_TLS_CERT_FILE=/path/to/cert.pem
SERVER_TLS_KEY_FILE=/path/to/key.pem

# Enable profiling endpoints (development only)
SERVER_ENABLE_PROFILING=false

# =============================================================================
# STORAGE SETTINGS
# =============================================================================

# Batching settings
STORAGE_BATCH_SIZE=1000
STORAGE_FLUSH_INTERVAL=5s

# Document size limit (Couchbase max is 20MB)
STORAGE_DOCUMENT_SIZE_LIMIT=20971520

# Time series bucketing interval (affects document organization)
STORAGE_TIMESERIES_INTERVAL=1h

# Data retention period (documents auto-expire after this)
STORAGE_RETENTION_PERIOD=720h  # 30 days

# Enable compression for time series data
STORAGE_COMPRESSION_ENABLED=true

# =============================================================================
# METRICS AND MONITORING
# =============================================================================

# Internal metrics endpoint
METRICS_ENABLED=true
METRICS_PATH=/metrics
